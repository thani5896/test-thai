<!DOCTYPE html>
<html lang="th">

<head>
    <!-- ตั้งค่าหน้าเว็บ -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ชื่อเว็บไซต์</title>
</head>

<body>

    <!-- ส่วนหัว -->
    <header>
        <h1>หัวข้อเว็บไซต์</h1>
        <p>คำอธิบายเว็บไซต์</p>
    </header>

    <!-- เมนู -->
    <nav>
        <a href="#about">เกี่ยวกับ</a> |
        <a href="#service">บริการ</a> |
        <a href="#table">ตาราง</a> |
        <a href="#contact">ติดต่อ</a>
    </nav>

    <!-- เนื้อหาหลัก -->
    <main>

        <!-- ข้อมูล -->
        <section id="about">

            <h2>เกี่ยวกับ</h2>

            <!-- รูปภาพ -->
            <img src="image.jpg" alt="รูปภาพ" width="200">

            <!-- ข้อความ -->
            <p>รายละเอียดที่ 1</p>
            <p>รายละเอียดที่ 2</p>

        </section>

        <!-- รายการ -->
        <section id="service">

            <h2>รายการแบบไม่เรียง</h2>

            <ul>
                <li>HTML</li>
                <li>CSS</li>
                <li>JavaScript</li>
            </ul>

            <h2>รายการแบบเรียง</h2>

            <ol>
                <li>ข้อที่ 1</li>
                <li>ข้อที่ 2</li>
                <li>ข้อที่ 3</li>
            </ol>

        </section>

        <!-- ตาราง -->
        <section id="table">

            <h2>ตารางข้อมูล</h2>

            <table border="1">

                <tr>
                    <th rowspan="2">วัน</th>
                    <th colspan="2">เวลา</th>
                </tr>

                <tr>
                    <th>เช้า</th>
                    <th>บ่าย</th>
                </tr>

                <tr>
                    <td>จันทร์</td>
                    <td>HTML</td>
                    <td>CSS</td>
                </tr>

                <tr>
                    <td>อังคาร</td>
                    <td>JavaScript</td>
                    <td>PHP</td>
                </tr>

            </table>

        </section>

        <!-- ฟอร์ม -->
        <section id="contact">

            <h2>ติดต่อ</h2>

            <form>

                <label>ชื่อ</label><br>
                <input type="text"><br><br>

                <label>อีเมล</label><br>
                <input type="email"><br><br>

                <label>เพศ</label><br>

                <input type="radio" name="gender"> ชาย
                <input type="radio" name="gender"> หญิง

                <br><br>

                <label>ความสามารถ</label><br>

                <input type="checkbox"> HTML
                <input type="checkbox"> CSS
                <input type="checkbox"> JavaScript

                <br><br>

                <label>จังหวัด</label><br>

                <select>
                    <option>เชียงใหม่</option>
                    <option>ลำปาง</option>
                    <option>เชียงราย</option>
                </select>

                <br><br>

                <label>ข้อความ</label><br>

                <textarea rows="4" cols="30"></textarea>

                <br><br>

                <input type="submit" value="ส่งข้อมูล">
                <input type="reset" value="ล้างข้อมูล">

            </form>

        </section>

        <!-- ลิงก์ -->
        <section>

            <h2>Social Media</h2>

            <a href="https://facebook.com" target="_blank">Facebook</a>

            <br>

            <a href="https://instagram.com" target="_blank">Instagram</a>

        </section>

    </main>

    <!-- ส่วนท้าย -->
    <footer>

        <p>Copyright © 2026</p>

    </footer>

</body>

</html>
