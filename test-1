<!DOCTYPE html>
<html lang="th">

<head>

    <!-- กำหนดภาษาและการแสดงผล -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- ชื่อหน้าเว็บ -->
    <title>ประวัติส่วนตัว</title>

</head>

<body>

    <!-- ส่วนหัว -->
    <header>
        <h1>เว็บไซต์แนะนำตัว</h1>
        <p>ยินดีต้อนรับ</p>
    </header>

    <!-- เมนู -->
    <nav>
        <a href="#about">เกี่ยวกับฉัน</a> |
        <a href="#hobby">งานอดิเรก</a> |
        <a href="#table">ตารางเรียน</a> |
        <a href="#contact">ติดต่อ</a>
    </nav>

    <main>

        <!-- ข้อมูลส่วนตัว -->
        <section id="about">

            <h2>เกี่ยวกับฉัน</h2>

            <!-- รูปภาพ -->
            <img src="https://via.placeholder.com/200"
                 alt="รูปโปรไฟล์"
                 width="200">

            <!-- ข้อมูล -->
            <p>ชื่อ : ธนิศร พานิชผล</p>
            <p>กำลังศึกษาวิศวกรรมซอฟต์แวร์</p>

        </section>

        <!-- งานอดิเรก -->
        <section id="hobby">

            <h2>งานอดิเรก</h2>

            <!-- รายการแบบไม่เรียง -->
            <ul>
                <li>เล่นเกม</li>
                <li>ฟังเพลง</li>
                <li>เขียนโปรแกรม</li>
            </ul>

            <h2>วิชาที่ชอบ</h2>

            <!-- รายการแบบเรียง -->
            <ol>
                <li>HTML</li>
                <li>CSS</li>
                <li>JavaScript</li>
            </ol>

        </section>

        <!-- ตาราง -->
        <section id="table">

            <h2>ตารางเรียน</h2>

            <table border="1">

                <!-- หัวตาราง -->
                <tr>
                    <th rowspan="2">วัน</th>
                    <th colspan="2">เวลาเรียน</th>
                </tr>

                <tr>
                    <th>เช้า</th>
                    <th>บ่าย</th>
                </tr>

                <!-- ข้อมูลในตาราง -->
                <tr>
                    <td>จันทร์</td>
                    <td>HTML</td>
                    <td>CSS</td>
                </tr>

                <tr>
                    <td>อังคาร</td>
                    <td>JavaScript</td>
                    <td>Database</td>
                </tr>

            </table>

        </section>

        <!-- แบบฟอร์ม -->
        <section id="contact">

            <h2>ติดต่อ</h2>

            <form>

                <!-- ชื่อ -->
                <label>ชื่อ</label><br>
                <input type="text"><br><br>

                <!-- อีเมล -->
                <label>อีเมล</label><br>
                <input type="email"><br><br>

                <!-- ข้อความ -->
                <label>ข้อความ</label><br>
                <textarea rows="4" cols="30"></textarea><br><br>

                <!-- ปุ่มส่ง -->
                <input type="submit" value="ส่ง">

            </form>

        </section>

        <!-- ลิงก์ -->
        <section>

            <h2>Social Media</h2>

            <a href="https://facebook.com" target="_blank">Facebook</a>

            <br><br>

            <a href="https://instagram.com" target="_blank">Instagram</a>

        </section>

    </main>

    <!-- ส่วนท้าย -->
    <footer>
        <p>Copyright © 2026</p>
    </footer>

</body>

</html>
